*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Operit 平台内部目录（不入库）
/.backup/
/.operit/

# 逆向资源（含 APK、解包、apktool 产物、分析成果，均不入库）
/re-workspace/

# Rust 构建产物
/core/target/
# 各 Android 模块的构建产物（新增模块时记得在这里补一行）
/app/build/
/editor/build/
/translate/build/
/downloader/build/
/imageviewer/build/
/joblogs/build/
# .so 原生库产物（CI 交叉编译后提交到 beta 分支，main 不保留）
/app/src/main/jniLibs/

# Kotlin 构建缓存
/.kotlin/

# 官方 aapt2 二进制（由 setup_android_env.sh 在构建时下载/替换，不入库）
/tools/aapt2/

# Gradle 发行版 zip 预存目录（本地/CI 工作流自行检索·预存·命中，不入库上传）
# 保留 .gitkeep 占位，仅忽略 zip 本体
/tools/gradle/*.zip

# CI 产物收集临时目录（upload-artifact 前统一收集，不入库）
/dist/

# 帧率基线的取数产物（原始日志切片 + 生成的 .md/.json，都是「某一次采集」的数据，不入库）
# 结论与口径写在 docs/specs/frame-perf-design.md 里；这里只放 tools/perf/frame-baseline.py 跑出来的东西
/tools/perf/reports/
__pycache__/
*.pyc

# 原型设计草图（HTML 草图，永久不入库）
# 草图本体（index.html / app.js / style.css…）留在 /design/<原型名>/，DSH 侧边栏「原型预览」能扫到；
# 但同一件事的「说明与落实方案」（现状测绘 / 取舍论证 / 落地清单）是结论，抽一份进
# /docs/specs/prototypes/ 入库 —— 草图与结论的寿命不一样，见 /docs/README.md
/design/

# 审计 / 评审件（一次性的调查记录：契约审计、文档体检、落地记录）
# 它们的**结论**已经落进 /docs/specs/ 与代码，这里只是过程材料 ——
# 本地留着方便复查，不入库、也不进版本历史；看完可整目录删除。
/review/

# 注意：/docs/ **不再**整体忽略。
# 历史上来过一版「/docs/ 也忽略」的写法，代价是 core/src/html/mod.rs 长年引用一份
# docs/html-parser-design.md，而它从未进过版本库、丢失后无从找回 ——
# 注释指向不存在的文件比没有注释更坏。结论类文档必须入库：
# /docs/README.md（收纳规则）+ /docs/specs/（重点文档）。

# 校验文件（CI 在 beta 分支生成，main 不保留）
/verify/signature.txt

# 签名密钥：release 私钥不入库（通过 CI Secrets base64 注入）
# 但 debug.keystore 是固定 debug 签名（密码公开），入库以保证本地与 CI 的 Beta 签名一致、可覆盖安装
*.keystore
!app/debug.keystore
*.jks

# 本地排障用的 GitHub 凭据与脚本（**永久不入库**）
# 目录里有访问令牌与 SSH 私钥 —— 提交上去等于泄露。说明见 .local-gh/README.md。
/.local-gh/
