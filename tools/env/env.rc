# Branchbase 构建环境变量（进仓库，source 即可，不再运行时改 ~/.bashrc）
# 用法：source tools/env/env.rc
#
# 说明：本地 proot 环境的环境变量已从 setup_android_env.sh 的 configure_env_persistence()
# 迁移到此文件，进版本控制，可评审/可回滚/可跨机复现。

export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-17-openjdk-arm64}"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android}"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
export GRADLE_HOME="${GRADLE_HOME:-$HOME/gradle/gradle-9.1.0}"

# Rust 工具链（rustup 默认装在 ~/.cargo，env.rc 原先未纳入 PATH）
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"

# 文件名编码：proot / 精简容器里 locale 常是 POSIX，JVM 的 sun.jnu.encoding 会退化成
# ANSI_X3.4-1968，于是「中文名测试方法 + lambda」生成的 `测试名$1.class` 无法写盘，
# Kotlin 编译直接报 Internal compiler error（且 `-Dsun.jnu.encoding` 无法覆盖，只能靠 locale）。
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"

export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$JAVA_HOME/bin:$GRADLE_HOME/bin:$CARGO_HOME/bin:$PATH"
