# Branchbase 构建环境变量（进仓库，source 即可，不再运行时改 ~/.bashrc）
# 用法：source tools/env/env.rc
#
# 说明：本地 proot 环境的环境变量已从 setup_android_env.sh 的 configure_env_persistence()
# 迁移到此文件，进版本控制，可评审/可回滚/可跨机复现。

export JAVA_HOME="${JAVA_HOME:-/usr/lib/jvm/java-17-openjdk-arm64}"
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android}"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
export GRADLE_HOME="${GRADLE_HOME:-$HOME/gradle/gradle-9.1.0}"

export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$JAVA_HOME/bin:$GRADLE_HOME/bin:$PATH"
