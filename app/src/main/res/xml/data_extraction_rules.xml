<?xml version="1.0" encoding="utf-8"?><!--
  API 31+ 的备份 / 迁移规则。与 backup_rules.xml 保持同一口径：
  **仓库级凭据不参与云备份、也不参与设备迁移**（理由见 backup_rules.xml 的注释）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="repo_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="repo_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
